# Maintainer: panda <839027631@qq.com>
pkgname=gander
pkgver=0.6.6
pkgrel=1
pkgdesc="Cross-platform interactive process viewer (htop alternative) for Linux, macOS and FreeBSD"
arch=('x86_64' 'aarch64')
url="https://github.com/pandasir/gander"
license=('GPL-2.0-or-later')
depends=('gcc-libs')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5f24a9a9da63410c9df238c37ea784c5939b56772a920cb22ccdb7f4543879ca')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  # Cargo.toml sets `strip = true` for the release profile, which leaves the
  # `-debug` package that makepkg splits off with nothing but a 3 KB stub. Ask
  # cargo to keep the symbols and let makepkg's own stripping produce the real
  # debuginfo split.
  export CARGO_PROFILE_RELEASE_STRIP=none
  cargo build --release --locked --package gander-bin
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --locked --workspace
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$srcdir/target/release/gander" "$pkgdir/usr/bin/gander"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
